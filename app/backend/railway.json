{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps dist/server.js",
    "preDeployCommand": ["npm run migrate:prod"],
    "restartPolicyType": "ON_FAILURE"
  }
}
