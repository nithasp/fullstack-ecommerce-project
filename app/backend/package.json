{
  "name": "storefront-backend",
  "version": "1.0.0",
  "description": "A backend API for an online store",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "watch": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps ./dist/server.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env ENV=test npm run test:db && cross-env ENV=test tsx node_modules/jasmine/bin/jasmine.js",
    "test:coverage": "cross-env ENV=test npm run test:db && cross-env ENV=test c8 tsx node_modules/jasmine/bin/jasmine.js",
    "test:db": "db-migrate --env test reset && db-migrate --env test up",
    "migrate:up": "db-migrate up",
    "migrate:down": "db-migrate down",
    "migrate:reset": "db-migrate reset",
    "migrate:prod": "db-migrate --env production up",
    "seed:admin": "tsx src/scripts/seedAdmin.ts"
  },
  "keywords": [
    "api",
    "storefront",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jasmine": "^5.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^6.3.3",
    "tsc-watch": "^6.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1"
  }
}
