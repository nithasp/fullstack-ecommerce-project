{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**", "src/types/**", "src/server.ts", "src/scripts/**"],
  "reporter": ["text-summary", "lcov", "html"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "statements": 90,
  "branches": 75,
  "functions": 90,
  "lines": 90
}
