# Environment
ENV=dev

# Database Configuration
POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=storefront_dev
POSTGRES_TEST_DB=storefront_test
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password

# Bcrypt
BCRYPT_PASSWORD=your_bcrypt_pepper_here
SALT_ROUNDS=10

# JWT
TOKEN_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY_DAYS=7

# Server
PORT=3000
ALLOWED_ORIGIN=http://localhost:4200

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Optional — required only to verify webhook events (stripe listen --forward-to localhost:3000/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Optional — ISO currency code used for charges (default: usd)
STRIPE_CURRENCY=usd

# Omise / Opn Payments — Thai local methods: TrueMoney, Rabbit LINE Pay,
# ShopeePay, mobile/internet banking, installments.
# Test keys from https://dashboard.omise.co (Keys menu; no business docs needed for test mode).
OMISE_SECRET_KEY=skey_test_your_secret_key
# Optional — not used by the current redirect-based flows, kept for future card tokenization
OMISE_PUBLIC_KEY=pkey_test_your_public_key
# Optional — Omise account currency (default: thb, amounts charged in satang)
OMISE_CURRENCY=thb
