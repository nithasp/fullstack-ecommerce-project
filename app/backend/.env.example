# Environment
ENV=dev

# Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=storefront_dev
POSTGRES_TEST_DB=storefront_test
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password

# Bcrypt
BCRYPT_PASSWORD=your_bcrypt_pepper_here
SALT_ROUNDS=10

# JWT
TOKEN_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY_DAYS=7

# Server
PORT=3000
ALLOWED_ORIGIN=http://localhost:4200

# Rate limiting / body size (optional)
API_RATE_LIMIT=500
JSON_BODY_LIMIT=1mb

# Audit log — days an entry is kept before the daily cleanup deletes it (optional)
AUDIT_LOG_RETENTION_DAYS=90

# Admin bootstrap — used only by `npm run seed:admin`, which creates (or promotes) this account as admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345!!
ADMIN_FIRST_NAME=Wai
ADMIN_LAST_NAME=SPST
